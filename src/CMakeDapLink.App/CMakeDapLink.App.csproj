<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources/chip.ico</ApplicationIcon>
    <AssemblyName>STM32ProjectHelper</AssemblyName>
    <Title>STM32 工程助手 · CMake / Keil MDK / DAPLink</Title>
    <Description>STM32CubeMX 工程转换、CMake 环境配置、VS Code 编译与 DAPLink 烧录任务、源文件管理。</Description>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources/chip.ico" LogicalName="CMakeDapLink.ChipIcon" />
    <Content Include="$(RepositoryRoot)LICENSE" Link="LICENSE" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <ProjectReference Include="../CMakeDapLink.Core/CMakeDapLink.Core.csproj" />
  </ItemGroup>
</Project>

{
  "name": "stm32-project-helper",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "1.6.8",
  "publisher": "myfsillyba",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MYFSillyBa/auto-CMake.git"
  },
  "homepage": "https://github.com/MYFSillyBa/auto-CMake#readme",
  "bugs": {
    "url": "https://github.com/MYFSillyBa/auto-CMake/issues"
  },
  "keywords": [
    "stm32",
    "stm32cubemx",
    "keil",
    "mdk-arm",
    "cmake",
    "arm-gcc",
    "daplink",
    "cmsis-dap",
    "openocd",
    "embedded"
  ],
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "icon": "media/chip.png",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:stm32ProjectHelper.liveWatch",
    "workspaceContains:**/CMakeLists.txt",
    "workspaceContains:**/*.ioc",
    "workspaceContains:**/*.uvprojx",
    "workspaceContains:**/startup_stm32*.s",
    "workspaceContains:**/startup_stm32*.S",
    "workspaceContains:**/stm32*_hal_conf.h",
    "workspaceContains:**/STM32*.ld"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%trust%"
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "stm32ProjectHelper.open",
        "title": "%command.open%"
      },
      {
        "command": "stm32ProjectHelper.selectWorkspace",
        "title": "%command.selectWorkspace%",
        "icon": "$(folder-opened)"
      },
      {
        "command": "stm32ProjectHelper.refresh",
        "title": "%command.refresh%",
        "icon": "$(refresh)"
      },
      {
        "command": "stm32ProjectHelper.build",
        "title": "%command.build%"
      },
      {
        "command": "stm32ProjectHelper.flash",
        "title": "%command.flash%"
      },
      {
        "command": "stm32ProjectHelper.debug",
        "title": "%command.debug%"
      },
      {
        "command": "stm32ProjectHelper.signals",
        "title": "%command.signals%",
        "icon": "$(pulse)"
      },
      {
        "command": "stm32ProjectHelper.openLiveWatch",
        "title": "%command.liveWatch%",
        "icon": "media/live-watch-label.svg"
      },
      {
        "command": "stm32ProjectHelper.fixIntelligence",
        "title": "%command.fixIntelligence%"
      },
      {
        "command": "stm32ProjectHelper.setup",
        "title": "%command.setup%"
      }
    ],
    "keybindings": [
      {
        "command": "stm32ProjectHelper.build",
        "key": "f8",
        "when": "isWorkspaceTrusted && !inDebugMode && stm32ProjectHelper.activeProjectEditor && editorTextFocus || isWorkspaceTrusted && !inDebugMode && !terminalFocus && activeWebviewPanelId == stm32ProjectHelper.workbench"
      },
      {
        "command": "stm32ProjectHelper.flash",
        "key": "f7",
        "when": "isWorkspaceTrusted && !inDebugMode && stm32ProjectHelper.activeProjectEditor && editorTextFocus || isWorkspaceTrusted && !inDebugMode && !terminalFocus && activeWebviewPanelId == stm32ProjectHelper.workbench"
      },
      {
        "command": "stm32ProjectHelper.debug",
        "key": "f6",
        "when": "isWorkspaceTrusted && !inDebugMode && stm32ProjectHelper.activeProjectEditor && editorTextFocus || isWorkspaceTrusted && !inDebugMode && !terminalFocus && activeWebviewPanelId == stm32ProjectHelper.workbench"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "stm32ProjectHelper",
          "title": "%container%",
          "icon": "media/sidebar.svg"
        }
      ]
    },
    "views": {
      "stm32ProjectHelper": [
        {
          "id": "stm32ProjectHelper.navigation",
          "name": "%view%",
          "when": "!stm32ProjectHelper.liveWatchExpanded",
          "initialSize": 1
        },
        {
          "id": "stm32ProjectHelper.liveWatch",
          "name": "%view.liveWatch%",
          "type": "webview",
          "initialSize": 2
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "stm32ProjectHelper.selectWorkspace",
          "when": "view == stm32ProjectHelper.navigation",
          "group": "navigation"
        },
        {
          "command": "stm32ProjectHelper.refresh",
          "when": "view == stm32ProjectHelper.navigation",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "%configuration%",
      "properties": {
        "stm32ProjectHelper.autoOpen": {
          "type": "boolean",
          "default": true,
          "description": "%stm32ProjectHelper.autoOpen%"
        },
        "stm32ProjectHelper.tools.cMake": {
          "type": "string",
          "default": "",
          "description": "%stm32ProjectHelper.tools.cMake%",
          "scope": "machine-overridable"
        },
        "stm32ProjectHelper.tools.ninja": {
          "type": "string",
          "default": "",
          "description": "%stm32ProjectHelper.tools.ninja%",
          "scope": "machine-overridable"
        },
        "stm32ProjectHelper.tools.compiler": {
          "type": "string",
          "default": "",
          "description": "%stm32ProjectHelper.tools.compiler%",
          "scope": "machine-overridable"
        },
        "stm32ProjectHelper.tools.openOcd": {
          "type": "string",
          "default": "",
          "description": "%stm32ProjectHelper.tools.openOcd%",
          "scope": "machine-overridable"
        },
        "stm32ProjectHelper.liveWatch.tclPort": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "default": 0,
          "description": "%stm32ProjectHelper.liveWatch.tclPort%",
          "scope": "machine-overridable"
        },
        "stm32ProjectHelper.liveWatch.gdbPath": {
          "type": "string",
          "default": "",
          "description": "%stm32ProjectHelper.liveWatch.gdbPath%",
          "scope": "machine-overridable"
        },
        "stm32ProjectHelper.liveWatch.elfPath": {
          "type": "string",
          "default": "",
          "description": "%stm32ProjectHelper.liveWatch.elfPath%",
          "scope": "machine-overridable"
        },
        "stm32ProjectHelper.liveWatch.ramRegions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%stm32ProjectHelper.liveWatch.ramRegions%"
        },
        "stm32ProjectHelper.language": {
          "type": "string",
          "scope": "application",
          "default": "auto",
          "enum": [
            "auto",
            "zh-CN",
            "en"
          ],
          "enumItemLabels": [
            "%language.auto%",
            "%language.chinese%",
            "%language.english%"
          ],
          "description": "%language.description%",
          "enumDescriptions": [
            "%language.auto.description%",
            "%language.chinese.description%",
            "%language.english.description%"
          ]
        }
      }
    }
  },
  "scripts": {
    "check": "node --check extension.js && node --check bridge.js && node --check project-discovery.js && node --check view-state.js && node --check process-tree.js && node --check development-tools.js && node --check serial-session.js && node --check usage-statistics.js && node --check fault-report.js && node --check cubemx-sync.js && node --check media/workbench.js && node --check media/i18n.js && node --check media/ui-messages.js && node --check media/live-watch.js",
    "build": "node scripts/package.mjs",
    "package": "node scripts/package.mjs",
    "smoke": "node scripts/test-vscode.cjs",
    "test": "node --test test/*.test.cjs signal-dock/test/*.test.*",
    "build:signals": "node scripts/build-signals.mjs",
    "build:live-watch": "node scripts/build-live-watch.mjs"
  },
  "devDependencies": {
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "html-to-image": "1.11.13",
    "three": "0.187.0"
  },
  "dependencies": {
    "csv-parse": "7.0.3",
    "iconv-lite": "0.7.3",
    "serialport": "13.0.0"
  }
}

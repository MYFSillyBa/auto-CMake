{
  "name": "stm32-project-helper",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "1.2.0",
  "publisher": "myfsillyba",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MYFSillyBa/auto-CMake.git"
  },
  "homepage": "https://github.com/MYFSillyBa/auto-CMake#readme",
  "bugs": {
    "url": "https://github.com/MYFSillyBa/auto-CMake/issues"
  },
  "keywords": [
    "stm32",
    "stm32cubemx",
    "keil",
    "mdk-arm",
    "cmake",
    "arm-gcc",
    "daplink",
    "cmsis-dap",
    "openocd",
    "embedded"
  ],
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "icon": "media/chip.png",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "workspaceContains:**/*.ioc",
    "workspaceContains:**/*.uvprojx",
    "workspaceContains:**/startup_stm32*.s",
    "workspaceContains:**/startup_stm32*.S",
    "workspaceContains:**/stm32*_hal_conf.h",
    "workspaceContains:**/STM32*.ld"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%trust%"
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "stm32ProjectHelper.open",
        "title": "%command.open%"
      },
      {
        "command": "stm32ProjectHelper.selectWorkspace",
        "title": "%command.selectWorkspace%",
        "icon": "$(folder-opened)"
      },
      {
        "command": "stm32ProjectHelper.refresh",
        "title": "%command.refresh%",
        "icon": "$(refresh)"
      },
      {
        "command": "stm32ProjectHelper.build",
        "title": "%command.build%"
      },
      {
        "command": "stm32ProjectHelper.flash",
        "title": "%command.flash%"
      },
      {
        "command": "stm32ProjectHelper.setup",
        "title": "%command.setup%"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "stm32ProjectHelper",
          "title": "%container%",
          "icon": "media/sidebar.svg"
        }
      ]
    },
    "views": {
      "stm32ProjectHelper": [
        {
          "id": "stm32ProjectHelper.navigation",
          "name": "%view%"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "stm32ProjectHelper.selectWorkspace",
          "when": "view == stm32ProjectHelper.navigation",
          "group": "navigation"
        },
        {
          "command": "stm32ProjectHelper.refresh",
          "when": "view == stm32ProjectHelper.navigation",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "%configuration%",
      "properties": {
        "stm32ProjectHelper.autoOpen": {
          "type": "boolean",
          "default": true,
          "description": "%stm32ProjectHelper.autoOpen%"
        },
        "stm32ProjectHelper.tools.cMake": {
          "type": "string",
          "default": "",
          "description": "%stm32ProjectHelper.tools.cMake%",
          "scope": "machine-overridable"
        },
        "stm32ProjectHelper.tools.ninja": {
          "type": "string",
          "default": "",
          "description": "%stm32ProjectHelper.tools.ninja%",
          "scope": "machine-overridable"
        },
        "stm32ProjectHelper.tools.compiler": {
          "type": "string",
          "default": "",
          "description": "%stm32ProjectHelper.tools.compiler%",
          "scope": "machine-overridable"
        },
        "stm32ProjectHelper.tools.openOcd": {
          "type": "string",
          "default": "",
          "description": "%stm32ProjectHelper.tools.openOcd%",
          "scope": "machine-overridable"
        },
        "stm32ProjectHelper.language": {
          "type": "string",
          "scope": "application",
          "default": "auto",
          "enum": [
            "auto",
            "zh-CN",
            "en"
          ],
          "enumItemLabels": [
            "%language.auto%",
            "%language.chinese%",
            "%language.english%"
          ],
          "description": "%language.description%",
          "enumDescriptions": [
            "%language.auto.description%",
            "%language.chinese.description%",
            "%language.english.description%"
          ]
        }
      }
    }
  },
  "scripts": {
    "check": "node --check extension.js && node --check bridge.js && node --check project-discovery.js && node --check view-state.js && node --check process-tree.js && node --check media/workbench.js && node --check media/i18n.js && node --check media/ui-messages.js",
    "build": "node scripts/package.mjs",
    "package": "node scripts/package.mjs",
    "smoke": "node scripts/test-vscode.cjs",
    "test": "node --test test/*.test.cjs"
  },
  "devDependencies": {
    "@vscode/vsce": "4.0.0",
    "@vscode/test-electron": "3.1.0"
  }
}
